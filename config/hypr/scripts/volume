#!/usr/bin/env bash
# Adjust output/input volume and show a dunst OSD

set -euo pipefail

action="${1:-}"
target="${2:-sink}"

usage() {
  echo "Usage: volume <raise|lower|mute-toggle|+N|-N> [sink|source]" >&2
  exit 1
}

[[ -n $action ]] || usage

case "$target" in
  sink) node="@DEFAULT_AUDIO_SINK@" ;;
  source) node="@DEFAULT_AUDIO_SOURCE@" ;;
  *) usage ;;
esac

volume_info() {
  wpctl get-volume "$node"
}

volume_percent() {
  volume_info | awk '{ printf "%d", $2 * 100 }'
}

volume_muted() {
  volume_info | grep -q MUTED
}

notify_volume() {
  local percent icon summary
  percent="$(volume_percent)"

  if volume_muted || ((percent == 0)); then
    if [[ $target == source ]]; then
      icon="microphone-sensitivity-muted"
      summary="Microphone muted"
    else
      icon="audio-volume-muted"
      summary="Volume muted"
    fi
  elif ((percent <= 33)); then
    icon=$([[ $target == source ]] && echo "microphone-sensitivity-low" || echo "audio-volume-low")
    summary=$([[ $target == source ]] && echo "Microphone" || echo "Volume")
  elif ((percent <= 66)); then
    icon=$([[ $target == source ]] && echo "microphone-sensitivity-medium" || echo "audio-volume-medium")
    summary=$([[ $target == source ]] && echo "Microphone" || echo "Volume")
  else
    icon=$([[ $target == source ]] && echo "microphone-sensitivity-high" || echo "audio-volume-high")
    summary=$([[ $target == source ]] && echo "Microphone" || echo "Volume")
  fi

  dunstify \
    -a "volume" \
    -u low \
    -i "$icon" \
    -h string:x-canonical-private-synchronous:"volume-${target}" \
    -h int:value:"$percent" \
    "$summary" \
    "${percent}%"
}

case "$action" in
  raise) action="+5" ;;
  lower) action="-5" ;;
esac

if [[ $action == "mute-toggle" ]]; then
  runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  debounce_file="$runtime_dir/arch-setup-volume-${target}-mute.last"
  now=$(date +%s%3N)
  last=0
  [[ -r $debounce_file ]] && read -r last <"$debounce_file" || true
  if ((now - last < 250)); then
    exit 0
  fi
  printf '%s\n' "$now" >"$debounce_file"

  wpctl set-mute "$node" toggle
elif [[ $action =~ ^([+-])([0-9]+)$ ]]; then
  direction="${BASH_REMATCH[1]}"
  step="${BASH_REMATCH[2]}"

  if [[ $direction == "+" ]]; then
    wpctl set-volume -l 1.0 "$node" "${step}%+"
  else
    wpctl set-volume "$node" "${step}%-"
  fi
  wpctl set-mute "$node" 0
else
  usage
fi

notify_volume
